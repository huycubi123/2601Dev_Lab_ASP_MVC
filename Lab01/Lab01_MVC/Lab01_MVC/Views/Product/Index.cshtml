@model List<Lab01_MVC.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container product-management">

    <h2>Quản lý sản phẩm</h2>

    <table class="table product-table">

        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Created At</th>
                <th>Image</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var product in Model)
            {
                <tr>

                    <td>
                        @product.Id
                    </td>

                    <td>
                        @product.Name
                    </td>

                    <td>
                        @product.Price.ToString("#,##0") đ
                    </td>

                    <td>
                        @product.CreatedAt.ToString("dd-MM-yyyy")
                    </td>

                    <td>
                        <img src="@product.Image"
                             class="product-table-image"
                             alt="@product.Name" />
                    </td>

                    <td>
                        <button class="btn btn-success btn-sm">
                            View
                        </button>
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>