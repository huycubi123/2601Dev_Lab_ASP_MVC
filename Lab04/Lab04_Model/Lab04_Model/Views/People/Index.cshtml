@model IEnumerable<Lab04_Model.Models.People>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Thêm mới thành viên</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Avatar)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Birthday)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gender)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                @*@Html.DisplayFor(modelItem => item.Avartar)*@
                <img src= "@item.Avatar" alt="@item.Name" style = "width: 4rem"></img>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Birthday)
            </td>

            <td>
                @*@Html.DisplayFor(modelItem => item.Gender)*@
                    @if (item.Gender == 0)
                    {
                        <span>City</span>
                    }else if (item.Gender == 1)
                    {
                        <span>Nam</span>
                    }else
                    {
                        <span>Nữ</span>
                    }
                    </td>
            <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-warning" }) 
                        @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-success" }) 
                        @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-danger" })
            </td>
        </tr>
}
    </tbody>
</table>
